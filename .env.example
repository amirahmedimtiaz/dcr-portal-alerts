# Gmail sender and receiver. Use a Gmail App Password, not your normal password.
EMAIL_SENDER=your-gmail-address@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_RECEIVER=your-gmail-address@gmail.com

# Local application settings
DATABASE_PATH=portal.db
HOST=127.0.0.1
PORT=5000
DASHBOARD_URL=http://127.0.0.1:5000

# Scraper settings
PORTAL_BASE_URL=https://solardcrportal.nise.res.in
HISTORY_START_YEAR=2022
SCRAPE_TIMEOUT_SECONDS=45
SCRAPE_DELAY_SECONDS=0.15

# Send the initial baseline email, and send a weekly email even when unchanged.
SEND_INITIAL_EMAIL=0
SEND_NO_CHANGE_EMAIL=1
LOG_LEVEL=INFO
